unselectall;
deleteall;
clear;

gds_output='D:\Yue\gds\dispersion_wg\260417_dispersion3.gds';
gds_open=gdsopen(gds_output);
clnn1 = 3e-6; clnn2 = 10e-6; olap = 0.6e-6; point_num = 720;
apodize = 0;

#device
num=150;



wgw=0.8e-6;
dx=dy=0;
coup_ang=40/180*pi;

bet=20e-6;
bew=0.7e-6;
period=300e-6;

# -------- USER PARAMETERS --------
R = 150e-6;                     
theta_total = pi/2;        # 90 degrees
theta_e = pi/8;             # Euler portion angle (change if desired)
N1 = 500;                  # Euler resolution
N2 = 500;                   # Circle resolution
L_straight=0;

#Leng=[12.0180904039465,12.8356778870767,13.6963539753899,14.5973514731069]*1e-2;

Leng=[12.0180904039465,13.6963539753899]*1e-2;  #0.5, 0.55 width
 R=200e-6;
M=4;
N=2;
########################full compression
for (i=1:N){ #number of width
 
    wgw=0.5e-6+0.05e-6*(i-1);
 
   width=wgw;

    L1=20e-6*(i-1);
    L2=Leng(i)/4;

    dx=-3300e-6+0;
    dy=-17500e-6+10e-6*(i-1);
   
    point=pi/360;
    

    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-L1/2;L1/2;L1/2;-L1/2];
    y_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+R*2+L2;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-L1/2;L1/2;L1/2;-L1/2]+R*4+20e-6*3;
    y_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+R*2+L2;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-(3*20e-6-L1)/2;(3*20e-6-L1)/2;(3*20e-6-L1)/2;-(3*20e-6-L1)/2]+2*R+10e-6*3;
    y_m=[-wgw/2;-wgw/2;wgw/2;wgw/2];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-2000e-6;(3*20e-6-L1)/2;(3*20e-6-L1)/2;-2000e-6]-2*R-10e-6*3;
    y_m=[-wgw/2;-wgw/2;wgw/2;wgw/2];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
 
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-(3*20e-6-L1)/2;2500e-6;2500e-6;-(3*20e-6-L1)/2]+6*R+30e-6*3;
    y_m=[-wgw/2;-wgw/2;wgw/2;wgw/2];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    

    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]-L1/2-R;
    y_m=[0;L2;L2;0]+R;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+L1/2+R;
    y_m=[0;L2;L2;0]+R;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]-L1/2-R+4*R+20e-6*3;
    y_m=[0;L2;L2;0]+R;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+L1/2+R+4*R+20e-6*3;
    y_m=[0;L2;L2;0]+R;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
   
   x0=0;
   y0=0;
   
    Euler_bend;
   
   
   
    
    
    #gdsbegincell(gds_open,"pBIC");
    #theta1=[-pi/2:pi/500:0];
    #theta2=[0:-pi/500:-pi/2];
    #x_m=[-2*R-L1/2+(R+wgw/2)*cos(theta1);-2*R-L1/2+(R-wgw/2)*cos(theta2)];
    #y_m=[R+(R+wgw/2)*sin(theta1);R+(R-wgw/2)*sin(theta2)];
    #poly_m = [x_m+dx,y_m+dy];
    #gdsaddpoly(gds_open,1,poly_m);
    #gdsendcell(gds_open);
    
    
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[-pi/2:pi/500:0];
    theta2=[0:-pi/500:-pi/2];
    x_m=[-2*R-L1/2+(R+wgw/2)*cos(theta1);-2*R-L1/2+(R-wgw/2)*cos(theta2)]+4*R+20e-6*3;
    y_m=[R+(R+wgw/2)*sin(theta1);R+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    

    gdsbegincell(gds_open,"pBIC");
    theta1=[-pi/2:pi/500:0];
    theta2=[0:-pi/500:-pi/2];
    x_m=-[-2*R-L1/2+(R+wgw/2)*cos(theta1);-2*R-L1/2+(R-wgw/2)*cos(theta2)];
    y_m=[R+(R+wgw/2)*sin(theta1);R+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[-pi/2:pi/500:0];
    theta2=[0:-pi/500:-pi/2];
    x_m=-[-2*R-L1/2+(R+wgw/2)*cos(theta1);-2*R-L1/2+(R-wgw/2)*cos(theta2)]+4*R+20e-6*3;
    y_m=[R+(R+wgw/2)*sin(theta1);R+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
  
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[pi:-pi/500:pi/2];
    theta2=[pi/2:pi/500:pi];
    x_m=-[-L1/2+(R+wgw/2)*cos(theta1);-L1/2+(R-wgw/2)*cos(theta2)];
    y_m=[R+L2+(R+wgw/2)*sin(theta1);R+L2+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[pi:-pi/500:pi/2];
    theta2=[pi/2:pi/500:pi];
    x_m=-[-L1/2+(R+wgw/2)*cos(theta1);-L1/2+(R-wgw/2)*cos(theta2)]+4*R+20e-6*3;
    y_m=[R+L2+(R+wgw/2)*sin(theta1);R+L2+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
 
    gdsbegincell(gds_open,"pBIC");
    theta1=[pi:-pi/500:pi/2];
    theta2=[pi/2:pi/500:pi];
    x_m=[-L1/2+(R+wgw/2)*cos(theta1);-L1/2+(R-wgw/2)*cos(theta2)];
    y_m=[R+L2+(R+wgw/2)*sin(theta1);R+L2+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[pi:-pi/500:pi/2];
    theta2=[pi/2:pi/500:pi];
    x_m=[-L1/2+(R+wgw/2)*cos(theta1);-L1/2+(R-wgw/2)*cos(theta2)]+4*R+20e-6*3;
    y_m=[R+L2+(R+wgw/2)*sin(theta1);R+L2+(R-wgw/2)*sin(theta2)];
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    
    label_num_temp=1;
    label_posx=-3300e-6+-1000e-6;
    label_posy=dy+2e-6;
    label_height=3e-6;
    label_width=0.5e-6;
    Label_number;
    
    
    label_num_temp=mod(i,10);
    label_posx=-3300e-6+-997e-6;
    label_posy=dy+2e-6;
    label_height=3e-6;
    label_width=0.5e-6;
    Label_number;
    
    
    ###different length
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]-L1/2-R-10e-6*4;
    y_m=[0;Leng(N)/4;Leng(N)/4;0]+R+10e-6*4;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+L1/2+R+4*R+20e-6*3+10e-6*4;
    y_m=[0;Leng(N)/4;Leng(N)/4;0]+R+10e-6*4;

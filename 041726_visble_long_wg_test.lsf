    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+L1/2+R;
    y_m=[0;L2;L2;0]+R;
    poly_m = [x_m+dx,y_m+dy];

    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[-pi/2:pi/500:0];
    theta2=[0:-pi/500:-pi/2];
    x_m=[-2*R-L1/2+(R+wgw/2)*cos(theta1);-2*R-L1/2+(R-wgw/2)*cos(theta2)]-10e-6*4;
    y_m=[R+(R+wgw/2)*sin(theta1);R+(R-wgw/2)*sin(theta2)]+10e-6*4;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[-pi/2:pi/500:0];
    theta2=[0:-pi/500:-pi/2];
    x_m=-[-2*R-L1/2+(R+wgw/2)*cos(theta1);-2*R-L1/2+(R-wgw/2)*cos(theta2)]+4*R+20e-6*3+10e-6*4;
    y_m=[R+(R+wgw/2)*sin(theta1);R+(R-wgw/2)*sin(theta2)]+10e-6*4;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[pi:-pi/500:pi/2];
    theta2=[pi/2:pi/500:pi];
    x_m=-[-L1/2+(R+wgw/2)*cos(theta1);-L1/2+(R-wgw/2)*cos(theta2)]+4*R+20e-6*5;
    y_m=[R+Leng(N)/4+(R+wgw/2)*sin(theta1);R+Leng(N)/4+(R-wgw/2)*sin(theta2)]+10e-6*4;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    gdsbegincell(gds_open,"pBIC");
    theta1=[pi:-pi/500:pi/2];
    theta2=[pi/2:pi/500:pi];
    x_m=[-L1/2+(R+wgw/2)*cos(theta1);-L1/2+(R-wgw/2)*cos(theta2)]-10e-6*4;
    y_m=[R+Leng(N)/4+(R+wgw/2)*sin(theta1);R+Leng(N)/4+(R-wgw/2)*sin(theta2)]+10e-6*4;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-L1/2-10e-6*4;L1/2+10e-6*4+R*4+20e-6*3;L1/2+10e-6*4+R*4+20e-6*3;-L1/2-10e-6*4];
    y_m=[-wgw/2;-wgw/2;wgw/2;wgw/2]+R*2+Leng(N)/4+4*10e-6;
    poly_m = [x_m+dx,y_m+dy];
    gdsaddpoly(gds_open,1,poly_m);
    gdsendcell(gds_open);
    
    
    gdsbegincell(gds_open,"pBIC");
    x_m=[-2000e-6-2*R-10e-6*3;(3*20e-6-L1)/2-2*R-10e-6*7;(3*20e-6-L1)/2-2*R-10e-6*7;-2000e-6-2*R-10e-6*3];
